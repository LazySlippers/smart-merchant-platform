MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_HOST_PORT=13306
RABBITMQ_DEFAULT_USER=saas
RABBITMQ_DEFAULT_PASS=change-me-rabbit
NACOS_AUTH_TOKEN=VGhpc0lzQVNlY3VyZUJhc2U2NFNlY3JldEtleUZvck5hY29zMzJCeXRlcw==
NACOS_IDENTITY_KEY=saas-key
NACOS_IDENTITY_VALUE=change-me-nacos
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
INTERNAL_SIGNING_KEY=change-me-internal-signing-key-at-least-32-characters
# Local acceptance only. Production should override this and disable the sandbox provider.
SANDBOX_PAYMENT_ENABLED=true
SANDBOX_PAYMENT_CALLBACK_SECRET=change-me-local-payment-callback-secret
# Provider switches stay false until their adapters and merchant credentials are configured.
WECHAT_PAYMENT_ENABLED=false
ALIPAY_PAYMENT_ENABLED=false
PAYMENT_CALLBACK_TOLERANCE_SECONDS=300
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=platform-admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-platform-admin
